{"nonce":"cf954b673d4aa6e859a1ac77f9442cd217de4f3e39c95aebcc8bf6652abafe6a","report_data_input":"kubetee.attestation.v1","quote":"","cc_eventlog":"","tee":"tdx","runtime_class":"kata-qemu-tdx-runtime-rs","tls_possession":{"tls_signature":"","tls_signature_alg":"RS256","tls_signature_input":"sha256(nonce)","tls_cert_sha256":"43330b780ee943a2af2015c803c2b4bfa1cba92f2063423fed06c7eda0abf6b6"},"pod":"litellm-5dcbc54579-7rm6g","spec_version":"kubetee.attestation.v1","tee_type":"tdx","keyset":{"subject":"kubetee.attestation.v1/llm.kubetee.ai","not_after":"2026-12-21T10:08:05Z","tls_public_keys":[{"domain":"llm.kubetee.ai","spki_sha256":"3f728244ad1bb95542b14cdbf7f637105dc588f8958c862e4beffc450c000cd3"}],"signing_keys":[],"e2ee_keys":[]},"bindings":{"version":"kubetee.attestation.v1","report_data_statement":"{\"keyset_digest\":\"sha256:64f6b8c71a0452909b382f5abcaaa6a76ae5b58bf930ff8f78f5074e4a64873d\",\"nonce\":\"cf954b673d4aa6e859a1ac77f9442cd217de4f3e39c95aebcc8bf6652abafe6a\",\"purpose\":\"kubetee.attestation.v1\"}","keyset_digest":"sha256:64f6b8c71a0452909b382f5abcaaa6a76ae5b58bf930ff8f78f5074e4a64873d"},"evidence":{"quote":"","quote_report_data":"nkhngm9DeWUli0vPlk5gPjDTG2YqTz7w/8UMumEWM3EAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==","event_log":"","vm_config":{"algorithm":"sha384","version":"0.1.0","role":"litellm","files":{"aa.toml":"[token_configs]\n[token_configs.kbs]\nurl = \"http://kbs-service.trustee-operator-system.svc.cluster.local:8080\"\n","cdh.toml":"[kbc]\nname = \"cc_kbc\"\nurl = \"http://kbs-service.trustee-operator-system.svc.cluster.local:8080\"\n","policy.rego":"package agent_policy\n\n# CoCo Init-Data agent policy for LiteLLM (CPU TDX, no init containers).\n# Exec/WriteStream denied so the host cannot steal Trustee-released material.\n# ReadStream stays on so kubectl logs works.\n#\n# CreateContainerRequest is allowlist-enforced (2026-09-18, todo 4):\n# only the pause container + the litellm gateway image may run in this guest,\n# each with its expected UID (the fetch-certs init retired 2026-10-24 —\n# eastwest-keys-strict fetches in-guest now). The same\n# policy_data.containers list is\n# extracted by the Trustee AS as agent_policy_claims (init-data is measured\n# into the TD, so this allowlist is part of the quote). For that extraction\n# (AS attestation-service/src/lib.rs extract_policy_data parses from the\n# policy-data declaration to EOF as JSON) the policy_data block MUST be the\n# last thing in this file and pure JSON after the brace — no trailing\n# commas, no rules after it, and the declaration literal must not appear\n# in any comment above it (find() would match the comment first). This\n# mirrors genpolicy's own output format (rules first, data last).\n\nimport future.keywords.in\n\ndefault CopyFileRequest := true\ndefault CreateContainerRequest := false\ndefault CreateSandboxRequest := true\ndefault DestroySandboxRequest := true\ndefault ExecProcessRequest := false\ndefault GetOOMEventRequest := true\ndefault GuestDetailsRequest := true\ndefault OnlineCPUMemRequest := true\ndefault PullImageRequest := true\ndefault ReadStreamRequest := true\ndefault RemoveContainerRequest := true\ndefault RemoveStaleVirtiofsShareMountsRequest := true\ndefault SignalProcessRequest := true\ndefault StartContainerRequest := true\ndefault StatsContainerRequest := true\ndefault TtyWinResizeRequest := true\ndefault UpdateEphemeralMountsRequest := true\ndefault UpdateInterfaceRequest := true\ndefault UpdateRoutesRequest := true\ndefault WaitProcessRequest := true\ndefault WriteStreamRequest := false\n\n# Allow only allowlisted containers. The pause container (container-type\n# \"sandbox\", no image-name annotation) and workload containers (image-name\n# annotation) are checked against policy_data.containers below.\nCreateContainerRequest if {\n\ti_oci := input.OCI\n\n\t# sandbox/pause container\n\ti_oci.Annotations[\"io.kubernetes.cri.container-type\"] == \"sandbox\"\n\tsome p in policy_data.containers\n\tp.OCI.Annotations[\"io.kubernetes.cri.container-type\"] == \"sandbox\"\n}\n\nCreateContainerRequest if {\n\ti_oci := input.OCI\n\ti_uid := i_oci.Process.User.UID\n\ti_gid := i_oci.Process.User.GID\n\n\ti_image := i_oci.Annotations[\"io.kubernetes.cri.image-name\"]\n\n\tsome p in policy_data.containers\n\tp.OCI.Annotations[\"io.kubernetes.cri.image-name\"] == i_image\n\n\tp_oci := p.OCI\n\tp_oci.Process.User.UID == i_uid\n\tp_oci.Process.User.GID == i_gid\n\n\t# pidns consistency: workload containers share the sandbox pid ns\n\tinput.sandbox_pidns == p.sandbox_pidns\n}\n\n# Measured container allowlist — image names + UIDs (+ the pause container by\n# container-type). Shape matches the AS extraction (agent_policy_claims):\n#   containers[].OCI.Annotations.\"io.kubernetes.cri.image-name\"\n#   containers[].OCI.Process.User.UID\n# UIDs (verified live via crictl on am-h200-28 2026-09-18): litellm-database\n# runs as root (UID 0, image Dockerfile USER root); the pause container runs\n# as 65535 (RKE2 mirrored-pause, \"nobody\"). sandbox_pidns is FALSE for every\n# container here — runtime-rs is_pid_namespace_enabled() returns true only\n# when the PID namespace entry has a path set, and these pods share no PID ns\n# (verified live: pid ns path=None on pause + both workloads). Image tags must\n# match the pod spec exactly (values.yaml pins the tag; Fleet never floats it).\n# Only the CURRENT image is listed (stale tags pruned 2026-10-24) — the\n# allowlist is part of the measured initdata, and a new image tag always\n# rebuilds initdata anyway. MUST stay last in this file (see header comment).\npolicy_data := {\n\t\"containers\": [\n\t\t{\n\t\t\t\"OCI\": {\n\t\t\t\t\"Annotations\": {\n\t\t\t\t\t\"io.kubernetes.cri.container-type\": \"sandbox\"\n\t\t\t\t},\n\t\t\t\t\"Process\": {\"User\": {\"UID\": 65535, \"GID\": 65535}}\n\t\t\t},\n\t\t\t\"sandbox_pidns\": false\n\t\t},\n\t\t{\n\t\t\t\"OCI\": {\n\t\t\t\t\"Annotations\": {\n\t\t\t\t\t\"io.kubernetes.cri.image-name\": \"ghcr.io/kubetee-ai/litellm-database:1.103.9-kubetee.5\"\n\t\t\t\t},\n\t\t\t\t\"Process\": {\"User\": {\"UID\": 0, \"GID\": 0, \"AdditionalGids\": [0]}}\n\t\t\t},\n\t\t\t\"sandbox_pidns\": false\n\t\t}\n\t]\n}\n"},"agent_policy_claims":{"containers":[{"OCI":{"Annotations":{"io.kubernetes.cri.container-type":"sandbox"},"Process":{"User":{"UID":65535,"GID":65535}}},"sandbox_pidns":false},{"OCI":{"Annotations":{"io.kubernetes.cri.image-name":"ghcr.io/kubetee-ai/litellm-database:1.103.9-kubetee.5"},"Process":{"User":{"UID":0,"GID":0,"AdditionalGids":[0]}}},"sandbox_pidns":false}]},"initdata_sha384":"71834451d5620d014b7f4c09fb34b76ddc87b9cf45de6193bc8c7b941699464ea46bece23f991815e7e9e9027a5ea840"}},"appraisal":{"ear_token":"..s2PoXm0lT50rCpovTTAL_k_RisNvmyQDOchfzwI2CMxnucexHHESWo59Q_VqTse66G9cdEVJV28skCaZe47Lxg","ar4si":{"status":"affirming","trustworthiness_vector":{"instance-identity":0,"configuration":2,"executables":3,"file-system":0,"hardware":2,"runtime-opaque":0,"storage-opaque":0,"sourced-data":0},"claims":{"serving_software_known_good":3,"tcb_up_to_date":2}}}}
