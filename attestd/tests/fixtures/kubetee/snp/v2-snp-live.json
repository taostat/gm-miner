kbc]\nname = \"cc_kbc\"\nurl = \"https://kbs.kubetee.ai\"\n'''\n\"policy.rego\" = '''\npackage agent_policy\n\n# LiteLLM on AMD SEV-SNP: pause, TLS fetch, credentials fetch and gateway.\n# Exec/WriteStream denied so the host cannot steal Trustee-released material.\n# ReadStream stays on so kubectl logs works.\n#\n# CreateContainerRequest is allowlist-enforced (2026-09-18, todo 4):\n# only the pause container + the litellm gateway image may run in this guest,\n# each with its expected UID (the fetch-certs init retired 2026-10-24 —\n# eastwest-keys-strict fetches in-guest now). The same\n# policy_data.containers list is\n# extracted by the Trustee AS as agent_policy_claims (init-data is measured\n# into the TD, so this allowlist is part of the quote). For that extraction\n# (AS attestation-service/src/lib.rs extract_policy_data parses from the\n# policy-data declaration to EOF as JSON) the policy_data block MUST be the\n# last thing in this file and pure JSON after the brace — no trailing\n# commas, no rules after it, and the declaration literal must not appear\n# in any comment above it (find() would match the comment first). This\n# mirrors genpolicy's own output format (rules first, data last).\n\nimport future.keywords.in\n\ndefault CopyFileRequest := true\ndefault CreateContainerRequest := false\ndefault CreateSandboxRequest := true\ndefault DestroySandboxRequest := true\ndefault ExecProcessRequest := false\ndefault GetOOMEventRequest := true\ndefault GuestDetailsRequest := true\ndefault OnlineCPUMemRequest := true\ndefault PullImageRequest := true\ndefault ReadStreamRequest := true\ndefault RemoveContainerRequest := true\ndefault RemoveStaleVirtiofsShareMountsRequest := true\ndefault SignalProcessRequest := true\ndefault StartContainerRequest := true\ndefault StatsContainerRequest := true\ndefault TtyWinResizeRequest := true\ndefault UpdateEphemeralMountsRequest := true\ndefault UpdateInterfaceRequest := true\ndefault UpdateRoutesRequest := true\ndefault WaitProcessRequest := true\ndefault WriteStreamRequest := false\n\n# Allow only allowlisted containers. The pause container (container-type\n# \"sandbox\", no image-name annotation) and workload containers (image-name\n# annotation) are checked against policy_data.containers below.\nCreateContainerRequest if {\n\ti_oci := input.OCI\n\n\t# sandbox/pause container\n\ti_oci.Annotations[\"io.kubernetes.cri.container-type\"] == \"sandbox\"\n\tsome p in policy_data.containers\n\tp.OCI.Annotations[\"io.kubernetes.cri.container-type\"] == \"sandbox\"\n}\n\nCreateContainerRequest if {\n\ti_oci := input.OCI\n\ti_uid := i_oci.Process.User.UID\n\ti_gid := i_oci.Process.User.GID\n\n\ti_image := i_oci.Annotations[\"io.kubernetes.cri.image-name\"]\n\n\tsome p in policy_data.containers\n\tp.OCI.Annotations[\"io.kubernetes.cri.image-name\"] == i_image\n\n\tp_oci := p.OCI\n\tp_oci.Process.User.UID == i_uid\n\tp_oci.Process.User.GID == i_gid\n\n\t# pidns consistency: workload containers share the sandbox pid ns\n\tinput.sandbox_pidns == p.sandbox_pidns\n}\n\n# Measured container allowlist — image names + UIDs (+ the pause container by\n# container-type). Shape matches the AS extraction (agent_policy_claims):\n#   containers[].OCI.Annotations.\"io.kubernetes.cri.image-name\"\n#   containers[].OCI.Process.User.UID\n# UIDs (verified live via crictl on am-h200-28 2026-09-18): litellm-database\n# runs as root (UID 0, image Dockerfile USER root); the pause container runs\n# as 65535 (RKE2 mirrored-pause, \"nobody\"). sandbox_pidns is FALSE for every\n# container here — runtime-rs is_pid_namespace_enabled() returns true only\n# when the PID namespace entry has a path set, and these pods share no PID ns\n# (verified live: pid ns path=None on pause + both workloads). Image references\n# must match OCI exactly: tag@digest is preserved by this runtime + containerd\n# path in io.kubernetes.cri.image-name (verified in host kata journal 2026-11-10).\n# Only the CURRENT image is listed (stale tags pruned 2